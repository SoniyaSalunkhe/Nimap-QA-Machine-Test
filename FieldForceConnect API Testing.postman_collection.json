      "name": "Auth",
      "item": [
        {
          "name": "Login - Valid Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200)); const data = pm.response.json(); pm.test(\"success is true\", () => pm.expect(data.success).to.eql(true)); pm.environment.set(\"userId\", data.userId); pm.environment.set(\"companyId\", data.companyId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"{{username}}\", \"password\": \"{{password}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/account/authenticate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "account",
                "authenticate"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login - Invalid Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));\r\nconst data = pm.response.json();\r\npm.test(\"success is false\", () => pm.expect(data.success).to.eql(false));\r\npm.test(\"Correct error message\", () => pm.expect(data.errormessage).to.eql(\"Invalid Email Id / Mobile No or Password.\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
